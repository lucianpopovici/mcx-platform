    </xs:complexType>

<xs:complexType name="tRequestType">
  <xs:sequence>
        <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="anyExt" type="mcpttloc:anyExtType" minOccurs="0"/>
